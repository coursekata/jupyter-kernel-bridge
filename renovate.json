{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>coursekata/docker-stacks//renovate/default.json"
  ],
  "enabledManagers": [
    "npm",
    "pep621",
    "github-actions"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "@jupyterlab/**",
        "jupyterlab"
      ],
      "groupName": "jupyterlab line"
    }
  ]
}
