{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "node",
    "lib": ["ES2022", "DOM"], "strict": true, "skipLibCheck": true,
    "declaration": true, "outDir": "lib", "rootDir": "src",
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src/**/*.ts"]
}
